:80 {
  root * /srv

  # SSE streams must not be compressed. Caddy's encode module withholds the
  # response headers until the first body bytes arrive (it is waiting to see
  # whether the response clears minimum_length), so an event stream that stays
  # idle after subscribing never completes its handshake and the browser's
  # EventSource hangs in CONNECTING. See caddyserver/caddy#6293.
  #
  # path_regexp, not a path glob: in a `path` matcher `*` does not cross `/`
  # (only the documented prefix/suffix/substring/one-segment forms work), so
  # `/api/*/events*` silently fails to match the real two-segment
  # `/api/collections/{id}/events` and would leave the stream compressed.
  @notsse not path_regexp ^/api/.+/events$
  encode @notsse gzip
  header {
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    X-XSS-Protection "0"
  }
  handle /api/* {
    reverse_proxy http://api:8080 {
      header_up X-Forwarded-Proto https
    }
  }

  handle {
    try_files {path} /index.html
    file_server {
      precompressed br gzip
    }
  }
}
