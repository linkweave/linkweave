{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["dist"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "import/no-duplicates": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }]
  }
}
